rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // PUBLIC can read events, announcements, gallery, team
    match /events/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /announcements/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gallery/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /team/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Feedback: anyone can submit, only logged-in admin can read/delete
    match /feedback/{doc} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
